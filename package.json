{
  "name": "storage",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "db:migrate": "drizzle-kit migrate",
    "start": "next start",
    "lint": "eslint .",
    "test:auth": "node tests/auth.test.mjs",
    "test:onboarding-rules": "ts-node --project tsconfig.test.json tests/onboarding-rules.test.ts",
    "test:onboarding": "node tests/onboarding.test.mjs",
    "test:rbac": "ts-node --project tsconfig.test.json tests/rbac-rules.test.ts",
    "test:staff-routing": "ts-node --project tsconfig.test.json tests/staff-role-routing.test.ts",
    "test:email": "ts-node --project tsconfig.test.json tests/email-templates.test.ts",
    "test:pos-pin": "ts-node --project tsconfig.test.json tests/pos-pin-policy.test.ts",
    "test:pos-sale": "ts-node --project tsconfig.test.json tests/pos-sale-rules.test.ts",
    "test:pos-shift-db": "node tests/pos-shift-db.integration.mjs",
    "test:inventory": "ts-node --project tsconfig.test.json tests/inventory-rules.test.ts",
    "test:reports": "ts-node --project tsconfig.test.json tests/report-rules.test.ts",
    "test:finance": "ts-node --project tsconfig.test.json tests/invoice-rules.test.ts && ts-node --project tsconfig.test.json tests/receivable-rules.test.ts && ts-node --project tsconfig.test.json tests/finance-operations.test.ts",
    "test:mpesa": "ts-node --project tsconfig.test.json tests/mpesa-rules.test.ts",
    "test:mpesa-concurrency": "node --test tests/mpesa-concurrency.integration.mjs",
    "test:mpesa-reconciliation": "node --test tests/mpesa-reconciliation.integration.mjs",
    "test:mpesa-integration": "pnpm run test:mpesa-concurrency && pnpm run test:mpesa-reconciliation",
    "test:rewards": "ts-node --project tsconfig.test.json tests/reward-rules.test.ts && node tests/reward-migration.test.mjs",
    "test:etims": "ts-node --project tsconfig.test.json tests/etims-rules.test.ts",
    "test:gavaconnect-auth": "node scripts/test-gavaconnect-auth.mjs",
    "test:offline-pos": "ts-node --project tsconfig.test.json tests/offline-pos-rules.test.ts",
    "test:offline-pos-db": "node --test tests/offline-pos-db.integration.mjs",
    "test:held-sales": "ts-node --project tsconfig.test.json tests/held-sale-rules.test.ts",
    "test:held-sales-db": "node --test tests/held-sales-db.integration.mjs",
    "test:product-packaging": "ts-node --project tsconfig.test.json tests/product-packaging.test.ts",
    "test:pharmacy": "ts-node --project tsconfig.test.json tests/pharmacy-rules.test.ts",
    "test:pharmacy-db": "node --test tests/pharmacy-db.integration.mjs",
    "test:product-packaging-db": "node --test tests/product-packaging-db.integration.mjs",
    "test": "pnpm run test:onboarding-rules && pnpm run test:rbac && pnpm run test:inventory && pnpm run test:reports && pnpm run test:email && pnpm run test:pos-pin && pnpm run test:auth && pnpm run test:onboarding",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
