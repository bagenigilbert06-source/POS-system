DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional shared cache. Use rediss:// for TLS-enabled Redis providers.
# The app safely falls back to PostgreSQL when Redis is not configured or unavailable.
REDIS_URL=
REDIS_CACHE_PREFIX=pesaby

# Server-only Brevo transactional email credentials. Never use NEXT_PUBLIC_ here.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Pesaby

# Safaricom Daraja M-Pesa Express (STK Push). Keep all values server-only.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Use CustomerPayBillOnline for a PayBill or CustomerBuyGoodsOnline for a Till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Manual customer payment account. Set to "till" for Buy Goods, otherwise PayBill.
MPESA_C2B_TYPE=paybill
MPESA_PASSKEY=
# Optional when BETTER_AUTH_URL is already your public HTTPS domain.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback
MPESA_CALLBACK_SECRET=
