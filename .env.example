DATABASE_URL=
# Optional fallback for environments such as WSL whose system DNS resolver is unavailable.
DATABASE_DNS_SERVERS=
DATABASE_CONNECTION_TIMEOUT_MS=12000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional shared cache. Use rediss:// for TLS-enabled Redis providers.
# The app safely falls back to PostgreSQL when Redis is not configured or unavailable.
REDIS_URL=
REDIS_CACHE_PREFIX=pesaby

# Server-only Brevo transactional email credentials. Never use NEXT_PUBLIC_ here.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Pesaby

# Safaricom Daraja M-Pesa Express (STK Push). Keep all values server-only.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Use CustomerPayBillOnline for a PayBill or CustomerBuyGoodsOnline for a Till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Manual customer payment account. Set to "till" for Buy Goods, otherwise PayBill.
MPESA_C2B_TYPE=paybill
# Enable only once when provisioning a Daraja app subscribed to the C2B API.
MPESA_REGISTER_C2B_URLS=false
MPESA_PASSKEY=
# Optional when BETTER_AUTH_URL is already your public HTTPS domain.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback
MPESA_CALLBACK_SECRET=
# Protects the server-only eTIMS retry worker endpoint. Use a long random value.
  ETIMS_RETRY_SECRET=""

  # Airtel Money Open API collections. Create an app at developers.airtel.africa.
  AIRTEL_ENV=sandbox
  AIRTEL_CLIENT_ID=
  AIRTEL_CLIENT_SECRET=
  AIRTEL_COUNTRY=KE
  AIRTEL_CURRENCY=KES

# QZ Tray direct thermal printing. These stay server-only. Production silent
# printing requires a trusted QZ certificate and server-side request signing.
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=
# Development only. Never enable unsigned QZ printing in production.
QZ_ALLOW_UNSIGNED_DEVELOPMENT=false

# RAW TCP receipt printer / emulator. Keep this server-only: the API only
# accepts the exact tcp://host:port target configured here.
POS_RAW_PRINTER_HOST=
POS_RAW_PRINTER_PORT=9100

# Provider credentials are referenced by name from branch configuration.
# Never prefix eTIMS secrets with NEXT_PUBLIC_.
ETIMS_PROVIDER_CLIENT_SECRET=""
ETIMS_PROVIDER_API_KEY=""
ETIMS_PROVIDER_CERTIFICATE=""
ETIMS_PROVIDER_PRIVATE_KEY=""

# GavaConnect eTIMS OSCU sandbox credentials (server-only; adapter disabled until documented)
GAVACONNECT_CONSUMER_KEY=""
GAVACONNECT_CONSUMER_SECRET=""
GAVACONNECT_APIGEE_APP_ID=""
